+    ml: 1, l: 1000, liter: 1000, dl: 100, cl: 10, // vloeistoffen: 1 ml ≈ 1 g (benadering, gemarkeerd)
+    el: 15, eetlepel: 15, eetlepels: 15, tbsp: 15, tl: 5, theelepel: 5, theelepels: 5, tsp: 5
